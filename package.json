{
  "name": "flw",
  "version": "0.2.0",
  "private": true,
  "description": "Personal DIY terminal-style CSS library for self-hosted projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fritzlaszlo/flw-ui-components.git"
  },
  "style": "dist/flw.css",
  "main": "dist/flw.js",
  "files": [
    "dist",
    "fonts",
    "src",
    "js",
    "examples/overview.html",
    "examples/synth.html",
    "AGENTS.md",
    "STYLE_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "fetch-fonts": "node scripts/fetch-fonts.js",
    "build": "node scripts/build.js",
    "serve": "npm run build && node scripts/serve.js"
  },
  "keywords": [
    "css",
    "terminal",
    "self-hosted"
  ]
}
